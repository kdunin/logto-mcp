# Required: M2M application credentials from Logto Console > Applications
LOGTO_APP_ID=your-m2m-app-id
LOGTO_APP_SECRET=your-m2m-app-secret

# Self-hosted / OSS (required for OSS)
LOGTO_ENDPOINT=https://your.logto.endpoint
# Optional; defaults to https://default.logto.app/api for OSS
# LOGTO_API_INDICATOR=https://default.logto.app/api
# Optional; defaults to "default" for OSS
# LOGTO_TENANT_ID=default

# Logto Cloud: set tenant id and omit LOGTO_ENDPOINT
# LOGTO_TENANT_ID=your-tenant-id
